# ========================================================
# DocuPro Environment Configuration Template
# ========================================================

NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:5173

# Database (PostgreSQL 16)
# docupro_migrator: Owner rôle pour les migrations Prisma DDL
# docupro_app: Rôle applicatif sans BYPASSRLS sous contraintes RLS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docupro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

DATABASE_URL=postgresql://docupro_app:app_dev_password@localhost:5432/docupro?schema=public
MIGRATION_DATABASE_URL=postgresql://docupro_migrator:migrator_dev_password@localhost:5432/docupro?schema=public

# Redis (Séparation Cache vs Tâches BullMQ)
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_BULLMQ_URL=redis://localhost:6380/0

# Storage (MinIO local S3 compatible)
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=docupro-storage
S3_REGION=us-east-1

# Antivirus
# Options: 'clamav' | 'mock' ('mock' formellement interdit en NODE_ENV=production)
ANTIVIRUS_DRIVER=mock
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Security & Secrets
SESSION_SECRET=change_me_super_secret_session_key_32_bytes_min
CSRF_SECRET=change_me_super_secret_csrf_key_32_bytes_min
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
